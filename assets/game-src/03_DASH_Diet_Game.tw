/* True if a food fits the player's diet choice.
   - "meat" foods (bacon, ham) are hidden for vegetarian and vegan.
   - "dairy" foods (frozen pizza's cheese) are hidden for vegan.
   - anything with no diet tag is a plant food, shown to everyone. */
setup.dash.fitsDiet = function (f) {
  var diet = State.variables.playerDiet || "everything";
  if (diet === "vegan" && (f.diet === "meat" || f.diet === "dairy")) return false;
  if (diet === "vegetarian" && f.diet === "meat") return false;
  return true;
};

/* Foods shown per day. The quiz stops after this many cards even when
   more foods still fit the player's diet, so each day is a short set and
   there are fresh foods left to see tomorrow. */
setup.dash.dailyLimit = 10;

/* How many quiz foods this player will actually see, given their diet.
   Used for the "Round X of N" labels so the count matches what they get.
   Capped at the daily limit so the label never promises more than a day
   actually serves. */
setup.dash.eligibleCount = function () {
  var fits = setup.dash.foods.filter(setup.dash.fitsDiet).length;
  return Math.min(fits, setup.dash.dailyLimit);
};

/* Draw the next food:
   - stop once the player has seen the daily limit of foods, so a day is
     a short set and there are new foods left for tomorrow
   - candidates = foods not yet in seenFoods (UPDATE6, no repeats) AND
     that fit the player's diet choice (veg / vegan hide animal foods)
   - none left  -> return null so Round Start ends the quiz (UPDATE7)
   - otherwise weight packaged items 2.5x vs 1x for fresh (UPDATE8),
     record the pick in seenFoods, stash it in $currentFood, return it. */
setup.dash.pickFood = function () {
  var seen = State.variables.seenFoods || [];
  if (seen.length >= setup.dash.dailyLimit) {
    return null;
  }
  var candidates = setup.dash.foods.filter(function (f) {
    return seen.indexOf(f.id) === -1 && setup.dash.fitsDiet(f);
  });
  if (candidates.length === 0) {
    return null;
  }
  var weights = candidates.map(function (f) {
    return f.packaged ? 2.5 : 1;
  });
  var total = 0;
  for (var i = 0; i < weights.length; i++) {
    total += weights[i];
  }
  var r = Math.random() * total;
  var chosen = candidates[candidates.length - 1];
  for (var j = 0; j < candidates.length; j++) {
    r -= weights[j];
    if (r <= 0) {
      chosen = candidates[j];
      break;
    }
  }
  seen.push(chosen.id);
  State.variables.seenFoods = seen;
  State.variables.currentFood = chosen;
  return chosen;
};
